JWT_SECRET=change-me-to-secure-256-bit-key

# Database Configuration (dla lokalnego developmentu)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=freelanceos
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Flyway CLI (dla gradlew flywayMigrate)
DATABASE_URL=jdbc:postgresql://localhost:5432/freelanceos

# Frontend URL (dla CORS)
APP_FRONTEND_URL=http://localhost:3000
APP_OAUTH2_FRONTEND_CALLBACK_PATH=/oauth2/callback

# Spring Profile (default/dev/prod)
SPRING_PROFILES_ACTIVE=default

# OAuth2 Google (opcjonalne - zostaw puste jeśli nie używasz)
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# AI Service URL (opcjonalne)
AI_SERVICE_URL=http://localhost:8000

# SMTP (passwordless mail code)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_CONNECTION_TIMEOUT_MS=5000
MAIL_TIMEOUT_MS=5000
MAIL_WRITE_TIMEOUT_MS=5000
AUTH_MAIL_FROM=your-email@example.com
AUTH_MAIL_SUBJECT=Your Lance login code

# Passwordless auth code policy
AUTH_CODE_LENGTH=6
AUTH_CODE_TTL_SECONDS=600

# Refresh token cookie policy
AUTH_REFRESH_COOKIE_NAME=refresh_token
AUTH_REFRESH_COOKIE_PATH=/auth
AUTH_REFRESH_COOKIE_MAX_AGE_SECONDS=604800
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAME_SITE=Lax
