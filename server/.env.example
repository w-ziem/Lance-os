JWT_SECRET=change-me-to-secure-256-bit-key

# Database Configuration (dla lokalnego developmentu)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=freelanceos
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Flyway CLI (dla gradlew flywayMigrate)
DATABASE_URL=jdbc:postgresql://localhost:5432/freelanceos

# Frontend URL (dla CORS)
APP_FRONTEND_URL=http://localhost:3000

# Spring Profile (default/dev/prod)
SPRING_PROFILES_ACTIVE=default

# OAuth2 Google (opcjonalne - zostaw puste jeśli nie używasz)
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# AI Service URL (opcjonalne)
AI_SERVICE_URL=http://localhost:8000