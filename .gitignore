# Global ignores for this monorepo

# OS
Thumbs.db
.DS_Store
ehthumbs.db
Desktop.ini

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Node (frontend)
client/node_modules/
client/dist/
client/dist-ssr/
# Vite/Dev output
client/.vite/

# Java / Gradle (backend)
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*
.gradle/
server/build/
**/build/
!gradle/wrapper/gradle-wrapper.jar

# IDEs / editors
.vscode/
.idea/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/
*.code-workspace

# Environment / secrets
.env
server/.env
client/.env

# Misc
dist/
dist-ssr/

# Temporary files
*.tmp
*.temp

# Local config
*.local

*CLAUDE*
*copilot*


# .md files (for now will do README.md in the future)
*.md


# Keep lockfiles in version control (do not ignore package-lock.json / yarn.lock / pnpm-lock.yaml)
